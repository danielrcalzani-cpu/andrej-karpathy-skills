# Porta HTTP do servidor
PORT=3000
# Pasta do banco SQLite, fotos de comprovante e backups (fora da pasta pública)
DATA_DIR=./data
# Fuso horário da operação
APP_TIMEZONE=America/Manaus
# Usuário administrador criado automaticamente na primeira execução (só se não houver nenhum usuário)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=Administrador
# Defina 1 quando o sistema estiver atrás de HTTPS (cookie de sessão com flag Secure)
COOKIE_SECURE=0
# Tamanho máximo das fotos de comprovante, em MB
MAX_PHOTO_MB=8
