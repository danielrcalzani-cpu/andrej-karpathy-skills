{
  "name": "mercatto-entregas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Mercatto Decor — gestão de entregas (painel administrativo + app do entregador)",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --experimental-strip-types --disable-warning=ExperimentalWarning --watch server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node --experimental-strip-types --disable-warning=ExperimentalWarning server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test tests/*.test.ts",
    "create-user": "node --experimental-strip-types --disable-warning=ExperimentalWarning server/cli/create-user.ts",
    "import-legacy": "node --experimental-strip-types --disable-warning=ExperimentalWarning server/cli/import-legacy.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "build:artifact": "node scripts/build-artifact.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "lucide-react": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~5.9.3",
    "vite": "^8.3.5"
  }
}
